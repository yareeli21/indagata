  "instrument": {
    "title": "Evaluación de Liderazgo y Participación Estudiantil",
    "objective": "No especificado",
    "dimensions_explored": [
      "SECCIÓN: HABILIDADES DE LIDERAZGO (LIKERT CONDUCTUAL)",
      "SECCIÓN: CONOCIMIENTO SOBRE LIDERAZGO",
      "SECCIÓN: PARTICIPACIÓN ESTUDIANTIL: SÍ / NO"
    ],
    "sections": [
      {
        "section_id": "s1",
        "name": "Reactivos",
        "questions": [
          {
            "question_id": "pru_10_Habilidade_q1",
            "text": "Tomo la iniciativa en proyectos grupales cuando se necesita liderazgo.",
            "type": "escala",
            "options": []
          },
          {
            "question_id": "pru_10_Habilidade_q2",
            "text": "Motivo a mis compañeros cuando el grupo enfrenta dificultades.",
            "type": "escala",
            "options": []
          },
          {
            "question_id": "pru_10_Habilidade_q3",
            "text": "Comunico mis ideas con claridad en contextos grupales.",
            "type": "escala",
            "options": []
          },
          {
            "question_id": "pru_10_Habilidade_q4",
            "text": "Tomo decisiones considerando el bienestar de todo el grupo.",
            "type": "escala",
            "options": []
          },
          {
            "question_id": "pru_10_Habilidade_q5",
            "text": "Resuelvo conflictos de manera constructiva en situaciones de desacuerdo.",
            "type": "escala",
            "options": []
          },
          {
            "question_id": "pru_10_Habilidade_q6",
            "text": "Reconozco las fortalezas de mis compañeros y las aprovecho en el trabajo conjunto.",
            "type": "escala",
            "options": []
          },
          {
            "question_id": "pru_10_Habilidade_q7",
            "text": "Me mantengo calmado/a bajo presión y ayudo al grupo a mantener el enfoque.",
            "type": "escala",
            "options": []
          },
          {
            "question_id": "pru_10_Habilidade_q8",
            "text": "Busco retroalimentación del grupo para mejorar mi desempeño como líder.",
            "type": "escala",
            "options": []
          },
          {
            "question_id": "pru_10_Conocimien_q1",
            "text": "¿Cuál es la principal diferencia entre un líder y un jefe?",
            "type": "opcion_multiple",
            "options": [
              "El líder tiene más autoridad formal",
              "El líder influye por respeto y confianza, no solo por posición jerárquica",
              "El jefe es más efectivo",
              "No hay diferencia relevante"
            ]
          },
          {
            "question_id": "pru_10_Conocimien_q2",
            "text": "El liderazgo transformacional se caracteriza por:",
            "type": "opcion_multiple",
            "options": [
              "Enfocarse solo en las tareas y resultados",
              "Inspirar y motivar a los seguidores hacia una visión compartida",
              "Aplicar recompensas y castigos",
              "Mantener el statu quo"
            ]
          },
          {
            "question_id": "pru_10_Conocimien_q3",
            "text": "¿Cuál es una característica del liderazgo situacional?",
            "type": "opcion_multiple",
            "options": [
              "Aplicar siempre el mismo estilo sin importar el contexto",
              "Adaptar el estilo de liderazgo según el nivel de madurez del equipo",
              "Tomar todas las decisiones sin consultar",
              "Evitar dar retroalimentación negativa"
            ]
          },
          {
            "question_id": "pru_10_Conocimien_q4",
            "text": "¿Qué implica la inteligencia emocional en el liderazgo estudiantil?",
            "type": "opcion_multiple",
            "options": [
              "Ignorar las emociones para ser más efectivo",
              "Reconocer, gestionar y responder a las emociones propias y ajenas de manera constructiva",
              "Mostrar siempre entusiasmo sin importar la situación",
              "Evitar el conflicto a toda costa"
            ]
          },
          {
            "question_id": "pru_10_Conocimien_q5",
            "text": "¿Cómo puede un estudiante desarrollar habilidades de liderazgo?",
            "type": "opcion_multiple",
            "options": [
              "Esperando a ser elegido formalmente",
              "Participando activamente en proyectos, organizaciones y roles de responsabilidad",
              "Solo leyendo libros de liderazgo",
              "Siendo el más inteligente del grupo"
            ]
          },
          {
            "question_id": "pru_10_Conocimien_q6",
            "text": "¿Qué es la escucha activa en el liderazgo?",
            "type": "opcion_multiple",
            "options": [
              "Fingir atención mientras se piensa en otra cosa",
              "Prestar atención plena al interlocutor y responder de manera reflexiva",
              "Solo escuchar para rebatir",
              "Interrumpir para mostrar interés"
            ]
          },
          {
            "question_id": "pru_10_Conocimien_q7",
            "text": "¿Cuál comportamiento indica falta de habilidades de liderazgo?",
            "type": "opcion_multiple",
            "options": [
              "Delegar responsabilidades apropiadamente",
              "Tomar todo el crédito y no reconocer el trabajo del equipo",
              "Pedir retroalimentación constantemente",
              "Admitir errores y aprender de ellos"
            ]
          },
          {
            "question_id": "pru_10_Conocimien_q8",
            "text": "La toma de decisiones en grupo se beneficia de la diversidad porque:",
            "type": "opcion_multiple",
            "options": [
              "Hace el proceso más lento sin añadir valor",
              "Aporta perspectivas variadas que reducen los sesgos y mejoran la calidad de las decisiones",
              "Garantiza que todos estén de acuerdo",
              "Evita que el líder tenga que decidir solo"
            ]
          },
          {
            "question_id": "pru_10_Participac_q1",
            "text": "¿Has ocupado un cargo de representación estudiantil (delegado/a, presidente de sociedad, etc.)?",
            "type": "si_no",
            "options": []
          },
          {
            "question_id": "pru_10_Participac_q2",
            "text": "¿Participas en organizaciones estudiantiles de tu institución?",
            "type": "si_no",
            "options": []
          },
          {
            "question_id": "pru_10_Participac_q3",
            "text": "¿Has liderado algún proyecto o iniciativa grupal en tu trayectoria universitaria?",
            "type": "si_no",
            "options": []
          },
          {
            "question_id": "pru_10_Participac_q4",
            "text": "¿Tu institución ofrece formación formal en habilidades de liderazgo estudiantil?",
            "type": "si_no",
            "options": []
          }
        ]
      }
    ],
    "contenido": ""
  },
