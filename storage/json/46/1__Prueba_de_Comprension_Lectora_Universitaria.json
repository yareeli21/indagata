  "instrument": {
    "title": "Prueba de Comprensión Lectora Universitaria",
    "objective": "Según el texto, ¿cuál es el objetivo principal del aprendizaje basado en problemas?",
    "dimensions_explored": [
      "SECCIÓN: COMPRENSIÓN DE TEXTOS ACADÉMICOS",
      "SECCIÓN: IDENTIFICACIÓN DE IDEAS PRINCIPALES",
      "SECCIÓN: VERDADERO O FALSO",
      "SECCIÓN: RESPUESTA CORTA"
    ],
    "sections": [
      {
        "section_id": "s1",
        "name": "Reactivos",
        "questions": [
          {
            "question_id": "pru_01_Comprensió_q1",
            "text": "Según el texto, ¿cuál es el objetivo principal del aprendizaje basado en problemas?",
            "type": "opcion_multiple",
            "options": [
              "Memorizar conceptos teóricos",
              "Desarrollar competencias para resolver situaciones reales",
              "Evaluar el rendimiento mediante exámenes",
              "Reducir la carga académica del estudiante"
            ]
          },
          {
            "question_id": "pru_01_Comprensió_q2",
            "text": "¿Qué papel cumple el docente en el modelo ABP descrito?",
            "type": "opcion_multiple",
            "options": [
              "Transmisor de información",
              "Evaluador exclusivo",
              "Facilitador del proceso de aprendizaje",
              "Supervisor disciplinario"
            ]
          },
          {
            "question_id": "pru_01_Comprensió_q3",
            "text": "¿Cuál de las siguientes NO es una competencia que desarrolla el ABP según el texto?",
            "type": "opcion_multiple",
            "options": [
              "Pensamiento crítico",
              "Memorización mecánica",
              "Trabajo colaborativo",
              "Resolución de problemas"
            ]
          },
          {
            "question_id": "pru_01_Comprensió_q4",
            "text": "¿En qué nivel educativo ha demostrado ser más efectivo el ABP?",
            "type": "opcion_multiple",
            "options": [
              "Educación primaria",
              "Bachillerato",
              "Educación universitaria y posgrado",
              "Educación inicial"
            ]
          },
          {
            "question_id": "pru_01_Comprensió_q5",
            "text": "Según el texto, ¿cómo se mide el éxito en un ambiente ABP?",
            "type": "opcion_multiple",
            "options": [
              "Por calificaciones numéricas únicamente",
              "Por la solución creativa y fundamentada del problema",
              "Por el tiempo que tarda el estudiante",
              "Por la participación en clase"
            ]
          },
          {
            "question_id": "pru_01_Comprensió_q6",
            "text": "¿Qué implica la metacognición en el contexto del ABP?",
            "type": "opcion_multiple",
            "options": [
              "Memorizar el proceso de aprendizaje",
              "Reflexionar sobre el propio proceso de aprendizaje",
              "Ignorar los errores cometidos",
              "Depender del docente para evaluar el aprendizaje"
            ]
          },
          {
            "question_id": "pru_01_Comprensió_q7",
            "text": "¿Cuál es una limitación del ABP mencionada en el texto?",
            "type": "opcion_multiple",
            "options": [
              "Requiere mucho tiempo y recursos",
              "Solo funciona en ciencias exactas",
              "No desarrolla habilidades sociales",
              "Es aplicable solo en posgrado"
            ]
          },
          {
            "question_id": "pru_01_Comprensió_q8",
            "text": "¿Qué tipo de evaluación predomina en el ABP?",
            "type": "opcion_multiple",
            "options": [
              "Evaluación sumativa final",
              "Evaluación formativa y continua",
              "Autoevaluación exclusiva",
              "Evaluación por coevaluación únicamente"
            ]
          },
          {
            "question_id": "pru_01_Comprensió_q9",
            "text": "Según el texto, ¿con qué habilidad del siglo XXI está más relacionado el ABP?",
            "type": "opcion_multiple",
            "options": [
              "Memorización de datos",
              "Transcripción de información",
              "Pensamiento crítico y resolución de problemas",
              "Obediencia a normas académicas"
            ]
          },
          {
            "question_id": "pru_01_Comprensió_q10",
            "text": "¿Cuál es la diferencia principal entre el aprendizaje tradicional y el ABP?",
            "type": "opcion_multiple",
            "options": [
              "El ABP usa más tecnología",
              "El ABP parte de problemas reales para construir conocimiento",
              "El aprendizaje tradicional es más efectivo",
              "No hay diferencias significativas"
            ]
          },
          {
            "question_id": "pru_01_Identifica_q1",
            "text": "¿Cuál de los siguientes párrafos expresa mejor la idea principal de un texto académico bien estructurado?",
            "type": "opcion_multiple",
            "options": [
              "Una lista de fechas históricas",
              "Una afirmación que sintetiza el argumento central",
              "Una descripción detallada de personajes",
              "Una serie de ejemplos concretos sin conclusión"
            ]
          },
          {
            "question_id": "pru_01_Identifica_q2",
            "text": "En un artículo científico, ¿dónde se ubica habitualmente la tesis o idea principal?",
            "type": "opcion_multiple",
            "options": [
              "En las referencias bibliográficas",
              "En la metodología",
              "En la introducción y las conclusiones",
              "Únicamente en el título"
            ]
          },
          {
            "question_id": "pru_01_Identifica_q3",
            "text": "¿Qué estrategia es más efectiva para identificar la idea principal de un texto?",
            "type": "opcion_multiple",
            "options": [
              "Leer solo el primer párrafo",
              "Buscar palabras clave recurrentes y el argumento central",
              "Leer únicamente las conclusiones",
              "Contar el número de párrafos"
            ]
          },
          {
            "question_id": "pru_01_Identifica_q4",
            "text": "Una idea secundaria en un texto académico cumple la función de:",
            "type": "opcion_multiple",
            "options": [
              "Sustituir a la idea principal",
              "Apoyar, ejemplificar o ampliar la idea principal",
              "Contradecir el argumento central",
              "Resumir el texto completo"
            ]
          },
          {
            "question_id": "pru_01_Identifica_q5",
            "text": "¿Cuál es la función de un párrafo de conclusión en un texto académico?",
            "type": "opcion_multiple",
            "options": [
              "Introducir nuevas ideas no desarrolladas",
              "Sintetizar las ideas principales y proyectar implicaciones",
              "Repetir literalmente la introducción",
              "Agregar bibliografía adicional"
            ]
          },
          {
            "question_id": "pru_01_Verdadero _q1",
            "text": "La idea principal siempre se encuentra en el primer párrafo de un texto.",
            "type": "verdadero_falso",
            "options": []
          },
          {
            "question_id": "pru_01_Verdadero _q2",
            "text": "El resumen de un artículo científico (abstract) refleja las ideas más importantes del trabajo.",
            "type": "verdadero_falso",
            "options": []
          },
          {
            "question_id": "pru_01_Verdadero _q3",
            "text": "En la lectura crítica, el lector acepta todas las afirmaciones del autor sin cuestionarlas.",
            "type": "verdadero_falso",
            "options": []
          },
          {
            "question_id": "pru_01_Verdadero _q4",
            "text": "La coherencia textual se refiere a la relación lógica entre las ideas de un texto.",
            "type": "verdadero_falso",
            "options": []
          },
          {
            "question_id": "pru_01_Verdadero _q5",
            "text": "Los conectores lógicos no tienen ningún impacto en la comprensión lectora.",
            "type": "verdadero_falso",
            "options": []
          },
          {
            "question_id": "pru_01_Respuesta _q1",
            "text": "Define con tus propias palabras qué es la comprensión lectora inferencial.",
            "type": "puntos",
            "options": []
          },
          {
            "question_id": "pru_01_Respuesta _q2",
            "text": "Menciona dos estrategias de lectura activa que uses en tus estudios.",
            "type": "puntos",
            "options": []
          },
          {
            "question_id": "pru_01_Respuesta _q3",
            "text": "¿Cuál es la diferencia entre parafrasear y plagiar un texto?",
            "type": "puntos",
            "options": []
          },
          {
            "question_id": "pru_01_Respuesta _q4",
            "text": "¿Por qué es importante identificar el propósito del autor al leer un texto académico?",
            "type": "puntos",
            "options": []
          },
          {
            "question_id": "pru_01_Respuesta _q5",
            "text": "Explica brevemente qué es la lectura crítica y para qué sirve.",
            "type": "puntos",
            "options": []
          }
        ]
      }
    ],
    "contenido": ""
  },
