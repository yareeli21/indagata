  "tipo_instrumento": "prueba_estandarizada",
  "instrument": {
    "title": "Prueba de Habilidades de Comunicación Académica",
    "objective": "B) Objetivo, metodología, resultados y conclusiones en forma concisa",
    "dimensions_explored": [
      "SECCIÓN: ESCRITURA ACADÉMICA",
      "SECCIÓN: VERDADERO / FALSO - COMUNICACIÓN ACADÉMICA"
    ],
    "sections": [
      {
        "section_id": "s1",
        "name": "Reactivos",
        "questions": [
          {
            "question_id": "pru_09_Escritura _q1",
            "text": "¿Cuál es la estructura básica de un texto académico argumentativo?",
            "type": "opcion_multiple",
            "options": [
              "Lista de datos-Conclusión",
              "Introducción-Desarrollo-Conclusión",
              "Resumen-Ejemplos-Datos",
              "Preguntas-Respuestas-Preguntas"
            ]
          },
          {
            "question_id": "pru_09_Escritura _q2",
            "text": "El abstract de un artículo académico debe incluir:",
            "type": "opcion_multiple",
            "options": [
              "Referencias bibliográficas detalladas",
              "Objetivo, metodología, resultados y conclusiones en forma concisa",
              "Los datos crudos de la investigación",
              "Una opinión personal del autor"
            ]
          },
          {
            "question_id": "pru_09_Escritura _q3",
            "text": "¿Cuál conectivo indica contraste o contraposición?",
            "type": "opcion_multiple",
            "options": [
              "Además",
              "Por lo tanto",
              "Sin embargo",
              "Por ejemplo"
            ]
          },
          {
            "question_id": "pru_09_Escritura _q4",
            "text": "La coherencia textual se refiere a:",
            "type": "opcion_multiple",
            "options": [
              "Usar muchas citas bibliográficas",
              "La relación lógica y progresiva de las ideas",
              "El número de palabras del texto",
              "El uso correcto de la puntuación"
            ]
          },
          {
            "question_id": "pru_09_Escritura _q5",
            "text": "En el estilo APA, una cita directa de más de 40 palabras se presenta:",
            "type": "opcion_multiple",
            "options": [
              "En negrita dentro del párrafo",
              "En un bloque de texto sangrado, sin comillas",
              "En cursiva y entre comillas",
              "Solo en la bibliografía"
            ]
          },
          {
            "question_id": "pru_09_Escritura _q6",
            "text": "¿Cuál es la diferencia entre paráfrasis y cita directa?",
            "type": "opcion_multiple",
            "options": [
              "No hay diferencia",
              "La paráfrasis reformula las ideas con palabras propias; la cita directa reproduce textualmente",
              "La cita directa es siempre más corta",
              "La paráfrasis no requiere citar la fuente"
            ]
          },
          {
            "question_id": "pru_09_Escritura _q7",
            "text": "¿Qué es la cohesión textual?",
            "type": "opcion_multiple",
            "options": [
              "La argumentación lógica del texto",
              "Los mecanismos lingüísticos que conectan las oraciones y párrafos",
              "El número de referencias citadas",
              "La longitud del texto"
            ]
          },
          {
            "question_id": "pru_09_Escritura _q8",
            "text": "¿Cuál de las siguientes es una fuente primaria?",
            "type": "opcion_multiple",
            "options": [
              "Una enciclopedia general",
              "Un artículo de revisión",
              "Un experimento o estudio original",
              "Un manual de texto"
            ]
          },
          {
            "question_id": "pru_09_Escritura _q9",
            "text": "¿Qué función cumple la discusión en un artículo científico?",
            "type": "opcion_multiple",
            "options": [
              "Repetir los resultados numéricos",
              "Interpretar los resultados en relación con la literatura y las hipótesis",
              "Presentar la metodología",
              "Listar las referencias"
            ]
          },
          {
            "question_id": "pru_09_Escritura _q10",
            "text": "¿Por qué es importante el uso de lenguaje no sexista en la escritura académica?",
            "type": "opcion_multiple",
            "options": [
              "Por estética únicamente",
              "Para promover la equidad de género e inclusión en el discurso",
              "Para cumplir un requisito editorial sin relevancia real",
              "Porque lo exige la gramática española"
            ]
          },
          {
            "question_id": "pru_09_Escritura _q11",
            "text": "¿Cuál es la función de las notas al pie en un texto académico?",
            "type": "opcion_multiple",
            "options": [
              "Reemplazar la bibliografía",
              "Ampliar información secundaria o aclarar aspectos sin interrumpir el flujo principal",
              "Resumir el texto",
              "Citar fuentes en formato APA"
            ]
          },
          {
            "question_id": "pru_09_Escritura _q12",
            "text": "El plagio involuntario ocurre cuando:",
            "type": "opcion_multiple",
            "options": [
              "El autor copia intencionalmente sin citar",
              "Se usa información de otros sin citar por desconocimiento o descuido",
              "Se inventa información",
              "Se autoplagia conscientemente"
            ]
          },
          {
            "question_id": "pru_09_Verdadero _q1",
            "text": "Un buen resumen académico puede incluir la opinión personal del autor.",
            "type": "verdadero_falso",
            "options": []
          },
          {
            "question_id": "pru_09_Verdadero _q2",
            "text": "El uso de un lenguaje formal en textos académicos implica evitar coloquialismos.",
            "type": "verdadero_falso",
            "options": []
          },
          {
            "question_id": "pru_09_Verdadero _q3",
            "text": "Reformular correctamente la idea de otro autor sin citarlo es una práctica académica aceptable.",
            "type": "verdadero_falso",
            "options": []
          },
          {
            "question_id": "pru_09_Verdadero _q4",
            "text": "La revisión por pares garantiza la calidad y rigor de un artículo científico.",
            "type": "verdadero_falso",
            "options": []
          },
          {
            "question_id": "pru_09_Verdadero _q5",
            "text": "En la escritura académica, los argumentos siempre deben estar respaldados por evidencia.",
            "type": "verdadero_falso",
            "options": []
          },
          {
            "question_id": "pru_09_Verdadero _q6",
            "text": "El uso excesivo de vocabulario técnico mejora siempre la claridad de un texto.",
            "type": "verdadero_falso",
            "options": []
          }
        ]
      }
    ],
    "contenido": ""
  },
