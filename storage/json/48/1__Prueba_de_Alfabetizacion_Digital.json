{
  "instrument_id": "48",
  "schema_version": "2.0",
  "tipo_instrumento": "prueba_estandarizada",
  "instrument": {
    "title": "Prueba de Alfabetización Digital",
    "objective": "¿Qué herramienta corresponde mejor al propósito de gestionar referencias bibliográficas?",
    "dimensions_explored": [
      "SECCIÓN: COMPETENCIAS DIGITALES BÁSICAS",
      "SECCIÓN: VERDADERO O FALSO DIGITAL",
      "SECCIÓN: ORDENAMIENTO Y EMPAREJAMIENTO (CODIFICADO COMO OPCIÓN MÚLTIPLE)"
    ],
    "sections": [
      {
        "section_id": "s1",
        "name": "Reactivos",
        "questions": [
          {
            "question_id": "pru_03_Competenci_q1",
            "text": "¿Cuál es la extensión correcta de un archivo de hoja de cálculo en Excel?",
            "type": "opcion_multiple",
            "options": [
              ".docx",
              ".xlsx",
              ".pptx",
              ".pdf"
            ]
          },
          {
            "question_id": "pru_03_Competenci_q2",
            "text": "¿Qué significa LMS en contextos educativos?",
            "type": "opcion_multiple",
            "options": [
              "Learning Management System",
              "Library Management Software",
              "Local Messaging System",
              "Lecture Multimedia Server"
            ]
          },
          {
            "question_id": "pru_03_Competenci_q3",
            "text": "¿Cuál es la principal función de una VPN?",
            "type": "opcion_multiple",
            "options": [
              "Aumentar la velocidad de internet",
              "Crear una conexión segura y privada",
              "Bloquear anuncios publicitarios",
              "Almacenar archivos en la nube"
            ]
          },
          {
            "question_id": "pru_03_Competenci_q4",
            "text": "¿Qué es el phishing?",
            "type": "opcion_multiple",
            "options": [
              "Un tipo de búsqueda en Google",
              "Un intento fraudulento de obtener información personal",
              "Una herramienta de edición de imágenes",
              "Un protocolo de transferencia de archivos"
            ]
          },
          {
            "question_id": "pru_03_Competenci_q5",
            "text": "¿Cuál herramienta es más adecuada para la colaboración en documentos en tiempo real?",
            "type": "opcion_multiple",
            "options": [
              "USB compartida",
              "Correo electrónico con adjuntos",
              "Google Docs o Microsoft 365",
              "Imprimir y entregar físicamente"
            ]
          },
          {
            "question_id": "pru_03_Competenci_q6",
            "text": "¿Qué es la nube (cloud computing) en tecnología?",
            "type": "opcion_multiple",
            "options": [
              "Un servidor físico en tu oficina",
              "Almacenamiento y servicios de internet a través de servidores remotos",
              "Una aplicación de mensajería",
              "Un hardware específico"
            ]
          },
          {
            "question_id": "pru_03_Competenci_q7",
            "text": "¿Qué significa una licencia Creative Commons?",
            "type": "opcion_multiple",
            "options": [
              "El contenido es completamente privado",
              "El autor permite ciertos usos de su obra bajo condiciones específicas",
              "El contenido puede ser vendido libremente",
              "El contenido no tiene derechos de autor"
            ]
          },
          {
            "question_id": "pru_03_Competenci_q8",
            "text": "¿Cuál es la principal función de un buscador web como Google?",
            "type": "opcion_multiple",
            "options": [
              "Almacenar información en la nube",
              "Indexar y recuperar páginas web relevantes",
              "Enviar correos electrónicos",
              "Crear presentaciones"
            ]
          },
          {
            "question_id": "pru_03_Competenci_q9",
            "text": "¿Cuál de los siguientes es un criterio para evaluar la confiabilidad de una fuente en internet?",
            "type": "opcion_multiple",
            "options": [
              "El número de visitas del sitio",
              "La autoridad del autor y la fecha de publicación",
              "El diseño visual del sitio web",
              "La cantidad de imágenes que tiene"
            ]
          },
          {
            "question_id": "pru_03_Competenci_q10",
            "text": "¿Qué es una contraseña segura?",
            "type": "opcion_multiple",
            "options": [
              "El nombre de tu mascota",
              "Una combinación de letras, números y símbolos de al menos 12 caracteres",
              "Tu fecha de nacimiento",
              "Una sola palabra del diccionario"
            ]
          },
          {
            "question_id": "pru_03_Verdadero _q1",
            "text": "El correo electrónico es siempre un canal seguro para enviar información confidencial.",
            "type": "verdadero_falso",
            "options": []
          },
          {
            "question_id": "pru_03_Verdadero _q2",
            "text": "El análisis de datos de aprendizaje (learning analytics) puede ayudar a identificar estudiantes en riesgo.",
            "type": "verdadero_falso",
            "options": []
          },
          {
            "question_id": "pru_03_Verdadero _q3",
            "text": "Plagiar contenido digital tiene las mismas consecuencias éticas que plagiar contenido impreso.",
            "type": "verdadero_falso",
            "options": []
          },
          {
            "question_id": "pru_03_Verdadero _q4",
            "text": "La inteligencia artificial puede generar texto, imágenes y código de programación.",
            "type": "verdadero_falso",
            "options": []
          },
          {
            "question_id": "pru_03_Verdadero _q5",
            "text": "Usar redes Wi-Fi públicas sin VPN es completamente seguro.",
            "type": "verdadero_falso",
            "options": []
          },
          {
            "question_id": "pru_03_Verdadero _q6",
            "text": "El almacenamiento en la nube elimina por completo el riesgo de perder datos.",
            "type": "verdadero_falso",
            "options": []
          },
          {
            "question_id": "pru_03_Verdadero _q7",
            "text": "La huella digital incluye todo rastro que dejamos en línea.",
            "type": "verdadero_falso",
            "options": []
          },
          {
            "question_id": "pru_03_Ordenamien_q1",
            "text": "¿Cuál es el orden correcto para crear un documento académico digital? (1) Guardar borrador (2) Investigar (3) Redactar (4) Revisar y citar fuentes",
            "type": "opcion_multiple",
            "options": [
              "1-2-3-4",
              "2-3-1-4",
              "3-4-2-1",
              "4-3-2-1"
            ]
          },
          {
            "question_id": "pru_03_Ordenamien_q2",
            "text": "Empareja: HTTPS →",
            "type": "opcion_multiple",
            "options": [
              "Protocolo de mensajería",
              "Protocolo seguro de transferencia web",
              "Servidor de correo",
              "Sistema de archivos"
            ]
          },
          {
            "question_id": "pru_03_Ordenamien_q3",
            "text": "¿Qué herramienta corresponde mejor al propósito de gestionar referencias bibliográficas?",
            "type": "opcion_multiple",
            "options": [
              "Canva",
              "Zotero o Mendeley",
              "Trello",
              "Photoshop"
            ]
          },
          {
            "question_id": "pru_03_Ordenamien_q4",
            "text": "¿Qué tipo de licencia permite modificar y redistribuir libremente un software?",
            "type": "opcion_multiple",
            "options": [
              "Propietaria",
              "Freeware",
              "Open Source / Código abierto",
              "Shareware"
            ]
          },
          {
            "question_id": "pru_03_Ordenamien_q5",
            "text": "¿Cuál es el emparejamiento correcto? Big Data ↔",
            "type": "opcion_multiple",
            "options": [
              "Impresión 3D",
              "Análisis de grandes volúmenes de datos",
              "Redes sociales únicamente",
              "Hardware de almacenamiento físico"
            ]
          }
        ]
      }
    ],
    "contenido": ""
  },
