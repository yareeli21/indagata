  "instrument": {
    "title": "Prueba de Competencia en Investigación Científica",
    "objective": "No especificado",
    "dimensions_explored": [
      "SECCIÓN: METODOLOGÍA DE INVESTIGACIÓN",
      "SECCIÓN: ÉTICA Y DIFUSIÓN CIENTÍFICA",
      "SECCIÓN: EMPAREJAMIENTO INVESTIGATIVO"
    ],
    "sections": [
      {
        "section_id": "s1",
        "name": "Reactivos",
        "questions": [
          {
            "question_id": "pru_06_Metodologí_q1",
            "text": "¿Qué caracteriza a la investigación cuantitativa?",
            "type": "opcion_multiple",
            "options": [
              "El uso de narrativas y significados subjetivos",
              "La medición numérica y el análisis estadístico",
              "La observación participante",
              "Las entrevistas en profundidad"
            ]
          },
          {
            "question_id": "pru_06_Metodologí_q2",
            "text": "La hipótesis en investigación científica es:",
            "type": "opcion_multiple",
            "options": [
              "La conclusión final del estudio",
              "Una suposición que se somete a verificación empírica",
              "La descripción del método",
              "El resumen del trabajo"
            ]
          },
          {
            "question_id": "pru_06_Metodologí_q3",
            "text": "¿Qué es la validez en un instrumento de medición?",
            "type": "opcion_multiple",
            "options": [
              "Que dé siempre los mismos resultados",
              "Que mida lo que realmente se pretende medir",
              "Que sea fácil de aplicar",
              "Que tenga muchos ítems"
            ]
          },
          {
            "question_id": "pru_06_Metodologí_q4",
            "text": "¿Qué es la triangulación en investigación?",
            "type": "opcion_multiple",
            "options": [
              "Usar solo un método de recolección de datos",
              "Combinar múltiples métodos o fuentes para validar resultados",
              "Dividir la muestra en tres grupos",
              "Usar estadística triangular"
            ]
          },
          {
            "question_id": "pru_06_Metodologí_q5",
            "text": "¿Cuál es la función del marco teórico en una investigación?",
            "type": "opcion_multiple",
            "options": [
              "Presentar los resultados obtenidos",
              "Sustentar conceptualmente el estudio y situar el problema en la literatura existente",
              "Describir la metodología",
              "Reemplazar los datos empíricos"
            ]
          },
          {
            "question_id": "pru_06_Metodologí_q6",
            "text": "Un muestreo probabilístico garantiza:",
            "type": "opcion_multiple",
            "options": [
              "Que todos los individuos de la población tienen igual probabilidad de ser seleccionados",
              "Que la muestra sea muy grande",
              "Que no haya errores en la investigación",
              "Que la investigación sea cualitativa"
            ]
          },
          {
            "question_id": "pru_06_Metodologí_q7",
            "text": "El coeficiente alpha de Cronbach mide:",
            "type": "opcion_multiple",
            "options": [
              "La validez del instrumento",
              "La confiabilidad de una escala de medición",
              "La correlación entre dos variables",
              "El tamaño de la muestra"
            ]
          },
          {
            "question_id": "pru_06_Metodologí_q8",
            "text": "¿Qué es una revisión sistemática de literatura?",
            "type": "opcion_multiple",
            "options": [
              "Leer todos los libros sobre un tema",
              "Una búsqueda estructurada, reproducible y crítica de evidencia sobre un tema",
              "Un resumen personal de lo que se sabe",
              "La bibliografía de un trabajo"
            ]
          },
          {
            "question_id": "pru_06_Ética y di_q1",
            "text": "El acceso abierto (open access) permite la lectura gratuita de artículos científicos.",
            "type": "verdadero_falso",
            "options": []
          },
          {
            "question_id": "pru_06_Ética y di_q2",
            "text": "La fabricación de datos en investigación es éticamente aceptable si el investigador cree que los resultados serán positivos.",
            "type": "verdadero_falso",
            "options": []
          },
          {
            "question_id": "pru_06_Ética y di_q3",
            "text": "El factor de impacto de una revista científica indica cuántas veces son citados en promedio sus artículos.",
            "type": "verdadero_falso",
            "options": []
          },
          {
            "question_id": "pru_06_Ética y di_q4",
            "text": "Publicar el mismo artículo en dos revistas distintas sin declararlo es una práctica de integridad científica.",
            "type": "verdadero_falso",
            "options": []
          },
          {
            "question_id": "pru_06_Emparejami_q1",
            "text": "¿Cuál base de datos es específicamente para artículos científicos indizados?",
            "type": "opcion_multiple",
            "options": [
              "Wikipedia",
              "Scopus o Web of Science",
              "Google Drive",
              "YouTube"
            ]
          },
          {
            "question_id": "pru_06_Emparejami_q2",
            "text": "El DOI (Digital Object Identifier) sirve para:",
            "type": "opcion_multiple",
            "options": [
              "Descargar artículos ilegalmente",
              "Identificar de manera permanente y única un documento digital",
              "Crear correos electrónicos académicos",
              "Almacenar datos de investigación"
            ]
          },
          {
            "question_id": "pru_06_Emparejami_q3",
            "text": "¿Qué es un artículo de revisión (review article)?",
            "type": "opcion_multiple",
            "options": [
              "Un artículo que critica a otros investigadores",
              "Una síntesis crítica del estado del conocimiento sobre un tema específico",
              "El primer artículo de un investigador",
              "Un artículo pendiente de revisión por pares"
            ]
          }
        ]
      }
    ],
    "contenido": ""
  },
