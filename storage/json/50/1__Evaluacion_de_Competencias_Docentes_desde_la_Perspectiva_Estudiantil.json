  "tipo_instrumento": "prueba_estandarizada",
  "instrument": {
    "title": "Evaluación de Competencias Docentes desde la Perspectiva Estudiantil",
    "objective": "¿Cuál es el objetivo de la evaluación diagnóstica?",
    "dimensions_explored": [
      "SECCIÓN: COMPETENCIAS PEDAGÓGICAS",
      "SECCIÓN: EVALUACIÓN Y ÉTICA DOCENTE"
    ],
    "sections": [
      {
        "section_id": "s1",
        "name": "Reactivos",
        "questions": [
          {
            "question_id": "pru_05_Competenci_q1",
            "text": "¿Cuál es la característica más importante de un docente universitario efectivo?",
            "type": "opcion_multiple",
            "options": [
              "Dominar exclusivamente la teoría",
              "Combinar conocimiento disciplinar con habilidades pedagógicas",
              "Usar muchas tecnologías",
              "Impartir clases de forma magistral"
            ]
          },
          {
            "question_id": "pru_05_Competenci_q2",
            "text": "Un docente que fomenta el pensamiento crítico principalmente:",
            "type": "opcion_multiple",
            "options": [
              "Da todas las respuestas antes de que el estudiante reflexione",
              "Plantea preguntas que generan análisis y debate",
              "Solo evalúa mediante exámenes escritos",
              "Impide que los estudiantes pregunten"
            ]
          },
          {
            "question_id": "pru_05_Competenci_q3",
            "text": "¿Qué indica la retroalimentación formativa de un docente?",
            "type": "opcion_multiple",
            "options": [
              "Una calificación final sin comentarios",
              "Comentarios sobre el proceso para mejorar el aprendizaje",
              "La nota de asistencia",
              "La evaluación del comportamiento"
            ]
          },
          {
            "question_id": "pru_05_Competenci_q4",
            "text": "Un docente inclusivo en el aula:",
            "type": "opcion_multiple",
            "options": [
              "Solo atiende a los estudiantes más brillantes",
              "Adapta su enseñanza a las diversas necesidades del grupo",
              "Ignora las diferencias entre los estudiantes",
              "Aplica el mismo método sin variaciones"
            ]
          },
          {
            "question_id": "pru_05_Competenci_q5",
            "text": "¿Cuál es la mejor forma de evaluar la comprensión profunda de un concepto?",
            "type": "opcion_multiple",
            "options": [
              "Examen de opciones múltiples con fechas",
              "Pedir al estudiante que explique y aplique el concepto en situaciones nuevas",
              "Repetir la definición del libro",
              "Copiar el concepto del pizarrón"
            ]
          },
          {
            "question_id": "pru_05_Competenci_q6",
            "text": "¿Qué es el aprendizaje activo en el aula universitaria?",
            "type": "opcion_multiple",
            "options": [
              "Escuchar al profesor sin interrumpir",
              "El estudiante participa, debate, experimenta y construye conocimiento",
              "Leer el libro de texto",
              "Tomar apuntes de manera pasiva"
            ]
          },
          {
            "question_id": "pru_05_Competenci_q7",
            "text": "¿Cuál es el riesgo del uso excesivo de la clase magistral?",
            "type": "opcion_multiple",
            "options": [
              "Que el docente aprenda demasiado",
              "Que favorezca el aprendizaje pasivo y la falta de participación",
              "Que los estudiantes participen en exceso",
              "Que se use demasiada tecnología"
            ]
          },
          {
            "question_id": "pru_05_Competenci_q8",
            "text": "La diversificación de estrategias didácticas permite:",
            "type": "opcion_multiple",
            "options": [
              "Reducir el esfuerzo del docente",
              "Atender distintos estilos de aprendizaje y mantener el interés",
              "Evaluar menos a los estudiantes",
              "Simplificar el contenido del curso"
            ]
          },
          {
            "question_id": "pru_05_Competenci_q9",
            "text": "¿Qué hace un docente que modela habilidades investigativas?",
            "type": "opcion_multiple",
            "options": [
              "Solo lee artículos en clase",
              "Muestra cómo busca, analiza y aplica conocimiento nuevo",
              "Evita hablar de sus propias investigaciones",
              "Solo da clases teóricas"
            ]
          },
          {
            "question_id": "pru_05_Competenci_q10",
            "text": "Un docente con alta inteligencia emocional en el aula:",
            "type": "opcion_multiple",
            "options": [
              "Ignora el estado emocional de los estudiantes",
              "Reconoce y gestiona las emociones propias y del grupo para favorecer el aprendizaje",
              "Solo se enfoca en los contenidos académicos",
              "Es más permisivo con las entregas"
            ]
          },
          {
            "question_id": "pru_05_Evaluación_q1",
            "text": "¿Cuál es una práctica ética esencial en la evaluación docente?",
            "type": "opcion_multiple",
            "options": [
              "Subir las notas a estudiantes favoritos",
              "Aplicar criterios de evaluación claros, justos y comunicados con anticipación",
              "Cambiar los criterios después del examen",
              "No devolver los exámenes calificados"
            ]
          },
          {
            "question_id": "pru_05_Evaluación_q2",
            "text": "¿Qué indica la rúbrica de evaluación?",
            "type": "opcion_multiple",
            "options": [
              "La lista de asistencia",
              "Los criterios y niveles de desempeño esperados",
              "El programa de la materia",
              "Las calificaciones finales"
            ]
          },
          {
            "question_id": "pru_05_Evaluación_q3",
            "text": "El plagio académico de los estudiantes es responsabilidad exclusivamente de:",
            "type": "opcion_multiple",
            "options": [
              "El docente",
              "El estudiante y la institución comparten la responsabilidad",
              "Solo la institución",
              "Solo el estudiante"
            ]
          },
          {
            "question_id": "pru_05_Evaluación_q4",
            "text": "¿Qué debe hacer un docente al detectar deshonestidad académica?",
            "type": "opcion_multiple",
            "options": [
              "Ignorarla para evitar conflictos",
              "Actuar conforme al protocolo institucional de integridad académica",
              "Reprobar al estudiante sin informarle",
              "Compartirlo públicamente"
            ]
          },
          {
            "question_id": "pru_05_Evaluación_q5",
            "text": "La evaluación sumativa sirve principalmente para:",
            "type": "opcion_multiple",
            "options": [
              "Guiar el proceso de aprendizaje durante el curso",
              "Certificar el nivel de logro al final del proceso de aprendizaje",
              "Motivar al estudiante",
              "Diagnosticar conocimientos previos"
            ]
          },
          {
            "question_id": "pru_05_Evaluación_q6",
            "text": "¿Qué implica la autoevaluación estudiantil como práctica pedagógica?",
            "type": "opcion_multiple",
            "options": [
              "El estudiante pone su propia nota sin criterios",
              "El estudiante reflexiona sobre su propio aprendizaje con criterios establecidos",
              "El docente no interviene en la evaluación",
              "La calificación siempre es la máxima"
            ]
          },
          {
            "question_id": "pru_05_Evaluación_q7",
            "text": "¿Cuál es el objetivo de la evaluación diagnóstica?",
            "type": "opcion_multiple",
            "options": [
              "Obtener la nota final",
              "Conocer los conocimientos previos para adaptar la enseñanza",
              "Evaluar el comportamiento del estudiante",
              "Determinar quién merece pasar el curso"
            ]
          },
          {
            "question_id": "pru_05_Evaluación_q8",
            "text": "¿Qué es la coevaluación?",
            "type": "opcion_multiple",
            "options": [
              "Cuando el docente evalúa sin criterios",
              "Cuando los estudiantes se evalúan mutuamente con criterios establecidos",
              "Cuando la institución evalúa al docente",
              "Cuando solo se evalúa la asistencia"
            ]
          },
          {
            "question_id": "pru_05_Evaluación_q9",
            "text": "Un docente que actualiza constantemente su práctica es más probable que:",
            "type": "opcion_multiple",
            "options": [
              "Abandone la docencia pronto",
              "Mejore la calidad del aprendizaje de sus estudiantes",
              "Genere más carga para los estudiantes",
              "Reciba peores evaluaciones"
            ]
          },
          {
            "question_id": "pru_05_Evaluación_q10",
            "text": "¿Por qué es importante que el docente conozca las teorías del aprendizaje?",
            "type": "opcion_multiple",
            "options": [
              "Para memorizar definiciones",
              "Para fundamentar sus decisiones pedagógicas y mejorar su práctica",
              "Para aprobar exámenes de certificación",
              "Para competir con otros docentes"
            ]
          }
        ]
      }
    ],
    "contenido": ""
  },
