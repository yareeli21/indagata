  "instrument": {
    "title": "Test de Orientación Vocacional y Aptitudes Profesionales",
    "objective": "No especificado",
    "dimensions_explored": [
      "SECCIÓN: APTITUDES PROFESIONALES",
      "SECCIÓN: ESCALAS DE PREFERENCIA PROFESIONAL"
    ],
    "sections": [
      {
        "section_id": "s1",
        "name": "Reactivos",
        "questions": [
          {
            "question_id": "pru_07_Aptitudes _q1",
            "text": "¿En qué ambiente de trabajo te desempeñarías mejor?",
            "type": "opcion_multiple",
            "options": [
              "Trabajo en solitario con mínima interacción",
              "Trabajo colaborativo con mucha interacción social",
              "Trabajo de campo al aire libre",
              "Trabajo remoto sin supervisión"
            ]
          },
          {
            "question_id": "pru_07_Aptitudes _q2",
            "text": "¿Qué tipo de problemas disfrutas resolver más?",
            "type": "opcion_multiple",
            "options": [
              "Problemas matemáticos o lógicos",
              "Problemas de comunicación y relaciones humanas",
              "Problemas artísticos y creativos",
              "Problemas técnicos con maquinaria"
            ]
          },
          {
            "question_id": "pru_07_Aptitudes _q3",
            "text": "¿Qué habilidad consideras tu mayor fortaleza?",
            "type": "opcion_multiple",
            "options": [
              "Análisis de datos",
              "Comunicación persuasiva",
              "Creatividad e innovación",
              "Organización y gestión de proyectos"
            ]
          },
          {
            "question_id": "pru_07_Aptitudes _q4",
            "text": "¿Qué actividad académica disfrutas más?",
            "type": "opcion_multiple",
            "options": [
              "Resolver ejercicios y problemas",
              "Leer y analizar textos",
              "Hacer presentaciones o debates",
              "Diseñar y crear proyectos"
            ]
          },
          {
            "question_id": "pru_07_Aptitudes _q5",
            "text": "¿Cuál sector laboral te atrae más?",
            "type": "opcion_multiple",
            "options": [
              "Tecnología e innovación",
              "Salud y bienestar",
              "Arte y entretenimiento",
              "Gobierno y política pública"
            ]
          },
          {
            "question_id": "pru_07_Aptitudes _q6",
            "text": "¿Qué valoras más en un trabajo?",
            "type": "opcion_multiple",
            "options": [
              "Estabilidad económica",
              "Impacto social y significado",
              "Autonomía y flexibilidad",
              "Reconocimiento y estatus"
            ]
          },
          {
            "question_id": "pru_07_Aptitudes _q7",
            "text": "¿Cuál descripción te identifica mejor como profesional?",
            "type": "opcion_multiple",
            "options": [
              "Analítico/a y orientado/a a datos",
              "Empático/a y orientado/a a personas",
              "Creativo/a e innovador/a",
              "Organizado/a y gestor/a de procesos"
            ]
          },
          {
            "question_id": "pru_07_Aptitudes _q8",
            "text": "¿Preferirías trabajar en qué tipo de organización?",
            "type": "opcion_multiple",
            "options": [
              "Empresa multinacional grande",
              "Startup o empresa pequeña",
              "Organización sin fines de lucro",
              "Institución académica o investigativa"
            ]
          },
          {
            "question_id": "pru_07_Aptitudes _q9",
            "text": "¿Cuándo enfrentas una decisión difícil, ¿qué haces primero?",
            "type": "opcion_multiple",
            "options": [
              "Analizo datos y evidencias disponibles",
              "Consulto con personas de confianza",
              "Confío en mi intuición",
              "Reviso procedimientos establecidos"
            ]
          },
          {
            "question_id": "pru_07_Aptitudes _q10",
            "text": "¿Cuál de estas habilidades te gustaría desarrollar más?",
            "type": "opcion_multiple",
            "options": [
              "Liderazgo",
              "Programación",
              "Negociación",
              "Investigación y análisis"
            ]
          },
          {
            "question_id": "pru_07_Aptitudes _q11",
            "text": "¿Cómo te sientes al trabajar en equipo?",
            "type": "opcion_multiple",
            "options": [
              "Prefiero trabajar solo/a",
              "Disfruto colaborar si hay roles claros",
              "Me adapto a cualquier dinámica",
              "Solo colaboro cuando es estrictamente necesario"
            ]
          },
          {
            "question_id": "pru_07_Aptitudes _q12",
            "text": "¿En cuál área te sientes más competente?",
            "type": "opcion_multiple",
            "options": [
              "Ciencias exactas y tecnología",
              "Humanidades y ciencias sociales",
              "Arte y diseño",
              "Administración y negocios"
            ]
          },
          {
            "question_id": "pru_07_Aptitudes _q13",
            "text": "¿Cuál es tu principal motivación profesional a largo plazo?",
            "type": "opcion_multiple",
            "options": [
              "Maximizar ingresos económicos",
              "Generar impacto positivo en la sociedad",
              "Ser reconocido/a en mi campo",
              "Construir un negocio propio"
            ]
          },
          {
            "question_id": "pru_07_Aptitudes _q14",
            "text": "¿Cómo prefieres aprender nuevas habilidades profesionales?",
            "type": "opcion_multiple",
            "options": [
              "Cursos formales y certificaciones",
              "Práctica directa en proyectos reales",
              "Mentoría de expertos",
              "Autoaprendizaje con recursos en línea"
            ]
          },
          {
            "question_id": "pru_07_Aptitudes _q15",
            "text": "¿Cuál aspecto del mundo laboral te preocupa más?",
            "type": "opcion_multiple",
            "options": [
              "La automatización y el desempleo tecnológico",
              "La falta de oportunidades en mi campo",
              "La inestabilidad económica global",
              "La dificultad para lograr equilibrio trabajo-vida"
            ]
          },
          {
            "question_id": "pru_07_Escalas de_q1",
            "text": "Me interesa trabajar en proyectos relacionados con la educación y el desarrollo humano.",
            "type": "escala",
            "options": []
          },
          {
            "question_id": "pru_07_Escalas de_q2",
            "text": "Me atrae la posibilidad de trabajar en investigación científica o académica.",
            "type": "escala",
            "options": []
          },
          {
            "question_id": "pru_07_Escalas de_q3",
            "text": "Prefiero entornos laborales predecibles y con procedimientos claros.",
            "type": "escala",
            "options": []
          },
          {
            "question_id": "pru_07_Escalas de_q4",
            "text": "Me entusiasma emprender y crear mis propios proyectos profesionales.",
            "type": "escala",
            "options": []
          },
          {
            "question_id": "pru_07_Escalas de_q5",
            "text": "Me importa que mi trabajo tenga un impacto social visible.",
            "type": "escala",
            "options": []
          },
          {
            "question_id": "pru_07_Escalas de_q6",
            "text": "Valoro el desarrollo continuo de habilidades y la formación permanente.",
            "type": "escala",
            "options": []
          },
          {
            "question_id": "pru_07_Escalas de_q7",
            "text": "Me interesa trabajar en entornos internacionales o multiculturales.",
            "type": "escala",
            "options": []
          },
          {
            "question_id": "pru_07_Escalas de_q8",
            "text": "Prefiero trabajos que me permitan tener autonomía en mis decisiones.",
            "type": "escala",
            "options": []
          },
          {
            "question_id": "pru_07_Escalas de_q9",
            "text": "Me motiva competir y superar metas de desempeño profesional.",
            "type": "escala",
            "options": []
          },
          {
            "question_id": "pru_07_Escalas de_q10",
            "text": "Aspiro a posiciones de liderazgo o gestión a lo largo de mi carrera.",
            "type": "escala",
            "options": []
          }
        ]
      }
