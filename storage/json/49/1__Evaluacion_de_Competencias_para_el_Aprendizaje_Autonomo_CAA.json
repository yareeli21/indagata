    ],
    "sections": [
      {
        "section_id": "s1",
        "name": "Reactivos",
        "questions": [
          {
            "question_id": "pru_04_Conductas _q1",
            "text": "Establezco mis propios objetivos de aprendizaje al inicio de cada materia.",
            "type": "escala",
            "options": []
          },
          {
            "question_id": "pru_04_Conductas _q2",
            "text": "Busco recursos adicionales cuando no entiendo completamente un tema.",
            "type": "escala",
            "options": []
          },
          {
            "question_id": "pru_04_Conductas _q3",
            "text": "Evalúo mi propio progreso sin esperar la retroalimentación del docente.",
            "type": "escala",
            "options": []
          },
          {
            "question_id": "pru_04_Conductas _q4",
            "text": "Adapto mis estrategias de estudio cuando los resultados no son los esperados.",
            "type": "escala",
            "options": []
          },
          {
            "question_id": "pru_04_Conductas _q5",
            "text": "Gestiono mi tiempo de manera independiente sin necesitar recordatorios externos.",
            "type": "escala",
            "options": []
          },
          {
            "question_id": "pru_04_Conductas _q6",
            "text": "Me hago responsable de mis fracasos académicos y busco soluciones.",
            "type": "escala",
            "options": []
          },
          {
            "question_id": "pru_04_Conductas _q7",
            "text": "Aprendo de mis errores en evaluaciones anteriores para mejorar.",
            "type": "escala",
            "options": []
          },
          {
            "question_id": "pru_04_Conductas _q8",
            "text": "Busco retroalimentación proactivamente para mejorar mi desempeño.",
            "type": "escala",
            "options": []
          },
          {
            "question_id": "pru_04_Conocimien_q1",
            "text": "¿Qué es la metacognición en el aprendizaje?",
            "type": "opcion_multiple",
            "options": [
              "La capacidad de memorizar mucha información",
              "El conocimiento y regulación del propio proceso de aprendizaje",
              "La velocidad de lectura",
              "La habilidad para tomar apuntes"
            ]
          },
          {
            "question_id": "pru_04_Conocimien_q2",
            "text": "¿Cuál técnica de estudio está más respaldada por la investigación?",
            "type": "opcion_multiple",
            "options": [
              "Leer el material una sola vez intensamente",
              "Subrayar todo el texto",
              "Práctica espaciada y recuperación activa",
              "Estudiar solo el día antes del examen"
            ]
          },
          {
            "question_id": "pru_04_Conocimien_q3",
            "text": "La zona de desarrollo próximo (Vygotsky) se refiere a:",
            "type": "opcion_multiple",
            "options": [
              "Lo que el estudiante no puede aprender nunca",
              "Lo que el estudiante puede lograr con apoyo de otro más competente",
              "El nivel actual de conocimiento sin ayuda",
              "El espacio físico de aprendizaje"
            ]
          },
          {
            "question_id": "pru_04_Conocimien_q4",
            "text": "¿Cuál es un indicador de aprendizaje superficial?",
            "type": "opcion_multiple",
            "options": [
              "Capacidad de explicar el concepto a otros",
              "Memorización de definiciones sin comprensión",
              "Aplicación de conceptos en situaciones nuevas",
              "Construcción de analogías propias"
            ]
          },
          {
            "question_id": "pru_04_Conocimien_q5",
            "text": "¿Qué es la mentalidad de crecimiento (growth mindset)?",
            "type": "opcion_multiple",
            "options": [
              "Creer que la inteligencia es fija e inamovible",
              "Pensar que las habilidades pueden desarrollarse con esfuerzo",
              "Evitar los desafíos por miedo al fracaso",
              "Depender de la motivación externa"
            ]
          },
          {
            "question_id": "pru_04_Conocimien_q6",
            "text": "¿Cuál es el beneficio de la autoexplicación como técnica de estudio?",
            "type": "opcion_multiple",
            "options": [
              "Ahorra tiempo de estudio",
              "Refuerza la comprensión al verbalizar el razonamiento",
              "Es más efectiva que cualquier otra técnica",
              "Solo sirve para matemáticas"
            ]
          },
          {
            "question_id": "pru_04_Autonomía:_q1",
            "text": "¿Tienes un horario de estudio personal que cumples regularmente?",
            "type": "si_no",
            "options": []
          },
          {
            "question_id": "pru_04_Autonomía:_q2",
            "text": "¿Buscas fuentes adicionales más allá de las asignadas por el profesor?",
            "type": "si_no",
            "options": []
          },
          {
            "question_id": "pru_04_Autonomía:_q3",
            "text": "¿Has tomado algún curso en línea por iniciativa propia (MOOC, YouTube, etc.)?",
            "type": "si_no",
            "options": []
          },
          {
            "question_id": "pru_04_Autonomía:_q4",
            "text": "¿Te fijas metas de aprendizaje concretas al inicio de cada semestre?",
            "type": "si_no",
            "options": []
          }
        ]
      }
    ],
    "contenido": ""
  },
