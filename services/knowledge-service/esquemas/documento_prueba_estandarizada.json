{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "documento_prueba_estandarizada.json",
  "title": "Documento final de una prueba estandarizada (v2.0: sin calificar)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "esquema_version",
    "instrumento",
    "kpis_asociados",
    "secciones",
    "reactivos",
    "alumnos",
    "avisos"
  ],
  "properties": {
    "esquema_version": {
      "const": "2.0"
    },
    "instrumento": {
      "allOf": [
        {
          "$ref": "comun.json#/$defs/instrumento"
        },
        {
          "properties": {
            "tipo": {
              "const": "prueba_estandarizada"
            }
          },
          "required": [
            "n_alumnos"
          ]
        }
      ]
    },
    "kpis_asociados": {
      "type": "array",
      "items": {
        "$ref": "comun.json#/$defs/kpi_asociado"
      }
    },
    "secciones": {
      "type": "array",
      "items": {
        "$ref": "comun.json#/$defs/seccion"
      }
    },
    "reactivos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "seccion_id",
          "clave",
          "texto",
          "opciones",
          "kpis_relacionados",
          "resumen"
        ],
        "properties": {
          "id": {
            "$ref": "comun.json#/$defs/id_hijo"
          },
          "seccion_id": {
            "$ref": "comun.json#/$defs/id_hijo"
          },
          "clave": {
            "type": "string",
            "description": "Nombre del reactivo en la hoja de respuestas (P3)."
          },
          "texto": {
            "type": "string"
          },
          "opciones": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "kpis_relacionados": {
            "$ref": "comun.json#/$defs/kpis_relacionados"
          },
          "resumen": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "n_alumnos",
              "distribucion",
              "opcion_mas_elegida",
              "n_nulas",
              "n_sin_respuesta",
              "interpretacion"
            ],
            "properties": {
              "n_alumnos": {
                "type": "integer",
                "minimum": 0
              },
              "distribucion": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "n",
                    "pct"
                  ],
                  "properties": {
                    "n": {
                      "type": "integer"
                    },
                    "pct": {
                      "type": "number"
                    }
                  }
                }
              },
              "opcion_mas_elegida": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "required": [
                  "opcion",
                  "significado",
                  "n",
                  "pct"
                ],
                "properties": {
                  "opcion": {
                    "type": "string"
                  },
                  "significado": {
                    "type": "string"
                  },
                  "n": {
                    "type": "integer"
                  },
                  "pct": {
                    "type": "number"
                  }
                }
              },
              "opciones_sin_elegir": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Opciones que ningún alumno eligió (opción múltiple y V/F)."
              },
              "n_nulas": {
                "type": "integer"
              },
              "n_sin_respuesta": {
                "type": "integer"
              },
              "media": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Solo en reactivos numéricos (puntos, escala, numérica)."
              },
              "interpretacion": {
                "type": "string"
              }
            }
          },
          "tipo_reactivo": {
            "enum": [
              "opcion_multiple",
              "verdadero_falso",
              "puntos",
              "escala",
              "si_no",
              "numerica"
            ]
          },
          "puntos_max": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "alumnos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "contexto",
          "n_respondidas",
          "n_nulas",
          "n_sin_respuesta",
          "respuestas"
        ],
        "properties": {
          "id": {
            "$ref": "comun.json#/$defs/id_hijo"
          },
          "contexto": {
            "$ref": "comun.json#/$defs/contexto"
          },
          "n_respondidas": {
            "type": "integer",
            "minimum": 0
          },
          "n_nulas": {
            "type": "integer",
            "minimum": 0
          },
          "n_sin_respuesta": {
            "type": "integer",
            "minimum": 0
          },
          "respuestas": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reactivo_id",
                "pregunta",
                "estado"
              ],
              "properties": {
                "reactivo_id": {
                  "$ref": "comun.json#/$defs/id_hijo"
                },
                "respuesta": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "significado": {
                  "type": "string"
                },
                "estado": {
                  "enum": [
                    "valida",
                    "nula",
                    "sin_respuesta"
                  ]
                },
                "motivo": {
                  "type": "string"
                },
                "pregunta": {
                  "type": "string",
                  "description": "Texto de la pregunta (para que la respuesta se entienda sola)."
                }
              }
            }
          }
        }
      }
    },
    "avisos": {
      "type": "array",
      "items": {
        "$ref": "comun.json#/$defs/aviso"
      }
    }
  },
  "description": "Indagata no califica las pruebas: describe lo que respondieron los alumnos, sin respuesta correcta."
}
