# Frontend (Node.js with Vite/React build)
FROM node:20-alpine as base

WORKDIR /app
COPY pixel-perfect-pixel/package*.json ./
RUN npm install

FROM node:20-alpine

WORKDIR /app
COPY --from=base /app/node_modules ./node_modules
COPY pixel-perfect-pixel/ ./

EXPOSE 3000

ENV VITE_API_URL=http://localhost:8006

# --host para exponer Vite fuera del contenedor; --port fija el puerto del compose.
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]
