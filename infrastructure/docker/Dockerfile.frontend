# Frontend (Node.js with Vite/React build)
FROM node:20-alpine as base

WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci

FROM node:20-alpine

WORKDIR /app
COPY --from=base /app/node_modules ./node_modules
COPY frontend/ ./

EXPOSE 3000

ENV VITE_API_URL=http://localhost:8000

CMD ["npm", "run", "dev"]
