# ==================== DATABASE ====================
POSTGRES_DB=indagata_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=securepassword
POSTGRES_PORT=5432

# ==================== APP ====================
SECRET_KEY=your-super-secret-key-change-in-production
APP_NAME=Indagata
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ==================== LLM ====================
OLLAMA_HOST=http://ollama:11434
# Redactor elegido en el experimento de modelos (documentación/03_Pruebas.md): gemma3:4b.
OLLAMA_MODEL=gemma3:4b
# Juez de las métricas del chat (fidelidad, relevancia, precisión del contexto); vacío = OLLAMA_MODEL.
RAG_JUEZ_MODELO=qwen3:4b-instruct
# Juez externo Claude Fable 5.2: evalúa CADA respuesta del chat con seis métricas tipo RAGAS (precisión y recuerdo
# del contexto, fidelidad, relevancia, sensibilidad al ruido, corrección factual). Sin clave queda «omitida».
ANTHROPIC_API_KEY=
RAG_JUEZ_FABLE=true
RAG_JUEZ_FABLE_MODELO=claude-fable-5-2
RAG_JUEZ_FABLE_ESFUERZO=high
# Horas que se reutiliza una respuesta idéntica del chat; pon 0 mientras haces pruebas comparativas.
RAG_CACHE_HORAS=24
# Opcional: clave de GNews (gnews.io) para el panel de noticias; sin ella se usan las fuentes RSS.
NOTICIAS_API_KEY=
# metadata-service: pedir al LLM los metadatos que no se pueden inferir del archivo.
METADATA_USAR_LLM=true

# ==================== STORAGE ====================
STORAGE_PATH=/app/storage
RAW_PATH=/app/storage/raw
JSON_PATH=/app/storage/json
SAV_PATH=/app/storage/sav
CHROMA_PATH=/app/chromadb/data
TEMP_PATH=/app/storage/temp

# ==================== SERVICES ====================
INSTRUMENT_SERVICE_URL=http://instrument-service:8001
ANALYSIS_SERVICE_URL=http://analysis-service:8002
METADATA_SERVICE_URL=http://metadata-service:8003
STORAGE_SERVICE_URL=http://storage-service:8004
VISUALIZATION_SERVICE_URL=http://visualization-service:8005

# ==================== FRONTEND ====================
VITE_API_URL=http://localhost:8006
NODE_ENV=development

# ==================== REDIS ====================
REDIS_HOST=redis
REDIS_PORT=6379
