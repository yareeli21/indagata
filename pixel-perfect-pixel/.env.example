# ─────────────────────────────────────────────────────────────────────────────
# Configuración del frontend INDAGATA (Vite). Copia este archivo a `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# URL base del api-gateway (FastAPI). En desarrollo local, el gateway corre en
# el puerto 8000 (ver docker-compose.yml). Sin barra final.
VITE_API_URL=http://localhost:8000

# Interruptor del backend real.
#   true  (por defecto) → la autenticación pega al api-gateway real.
#   false               → toda la app funciona con datos de ejemplo (mocks),
#                         útil para desarrollar la UI sin levantar servicios.
VITE_USAR_BACKEND=true
